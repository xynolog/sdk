cabal-version: 3.0
name: xynolog
version: @VERSION@
synopsis: Typed Xynolog SDK for Haskell
description: Protocol-derived models for the Xynolog knowledge platform.
license: Apache-2.0
license-file: LICENSE
category: Network
homepage: https://github.com/xynolog/sdk
bug-reports: https://github.com/xynolog/sdk/issues
author: Xynolog
-- No address: the project is reached through its issue tracker.
maintainer: Xynolog, at https://github.com/xynolog/sdk/issues
build-type: Simple
-- The lowest is cabal.project's with-compiler, which the tests build with.
tested-with: GHC == 9.10.3 || == 9.12.4
extra-source-files: test/store-owner-policy.py, test/store-owner-policy.ps1, test/store-lock-peer.py, generated/Xynolog/Internal/Generated/xynolog_store_policy.h, test/fixtures/*.pem, xynolog.cabal.in, README.md, run.sh, api.py, public-api.inputs.json, public-api.json, test/refusals.py, test/refusals/*.hs, test/http-peer.py, conformance/README.md, conformance/launch.sh
extra-doc-files: CHANGELOG.md

source-repository head
  type: git
  location: https://github.com/xynolog/sdk.git
  subdir: haskell/sdk

common settings
  default-language: GHC2021
  ghc-options: -Wall -Wincomplete-patterns -Wincomplete-record-updates
  build-depends:
    base >=4.20 && <4.22,
    aeson >=2.3 && <2.4,
    async >=2.2 && <2.3,
    bytestring >=0.12 && <0.13,
    base64-bytestring >=1.2 && <1.3,
    containers >=0.7 && <0.8,
    regex-tdfa >=1.3 && <1.4,
    scientific >=0.3 && <0.4,
    stm >=2.5 && <2.6,
    streaming >=0.2 && <0.3,
    text >=2.1 && <2.2,
    vector >=0.13 && <0.14,
    QuickCheck >=2.19 && <2.20

common context-propagation
  build-depends: hs-opentelemetry-api >=1.0 && <1.1, http-client >=0.7 && <0.8, http-types >=0.12 && <0.13, case-insensitive >=1.2 && <1.3, network-uri >=2.6 && <2.7, uuid-types >=1.0 && <1.1, unordered-containers >=0.2 && <0.3

common crypto
  build-depends: crypton >=2.2 && <2.3, ram >=0.22 && <0.23, crypton-pem >=0.3 && <0.4, crypton-x509 >=1.10 && <1.11, crypton-x509-store >=1.10 && <1.11

library
  default-language: GHC2021
  build-depends: base >=4.20 && <4.22, xynolog:internal
  reexported-modules: Xynolog.Types, Xynolog.Channels, Xynolog.Running, Xynolog.ErrorCodes, Xynolog.Timing, Xynolog.Timing.Settings, Xynolog.Retry, Xynolog.Discovery, Xynolog.Discovery.Reasons, Xynolog.Transport, Xynolog.Transport.Facts, Xynolog.StateValue, Xynolog.Errors, Xynolog.EventBus, Xynolog.Bus, Xynolog.Http, Xynolog.Http.Discovery, Xynolog.Content, Xynolog.Gateway, Xynolog.Frame, Xynolog.Auth, Xynolog.System, Xynolog.Client, Xynolog.JobFilter, Xynolog.Claims, Xynolog.HostName, Xynolog.Worker, Xynolog.Worker.Types, Xynolog.Bind, Xynolog.Beckon, Xynolog.Job, Xynolog.Cache, Xynolog.Resources, Xynolog.MediaTypes, Xynolog.Browse, Xynolog.Gather, Xynolog.Match, Xynolog.Delegation, Xynolog.Mark, Xynolog.Yield, Xynolog.Tokens, Xynolog.SessionStorage, Xynolog.Session, Xynolog.Issuer, Xynolog.Registry.Stored, Xynolog.ClientAssertion, Xynolog.ServiceToken, Xynolog.SignIn, Xynolog.SignInStore, Xynolog.Annotations, Xynolog.Identity, Xynolog.StoragePersister, Xynolog.State.SessionSignals, Xynolog.Registry.Identity, Xynolog.Registry.Factory, Xynolog.Registry.Resources, Xynolog.Registry, Xynolog.State.HoverDwell, Xynolog.State.Search, Xynolog.State.Beckon, Xynolog.State.Match, Xynolog.State.Gather, Xynolog.State.Mark, Xynolog.State.Yield, Xynolog.Testing, Xynolog.Testing.Client, Xynolog.Testing.Transport, Xynolog.Testing.Storage, Xynolog.Testing.Sessions, Xynolog.Testing.Liveness, Xynolog.Archivist.Routes, Xynolog.Control, Xynolog.ServiceEnvironment, Xynolog.ServiceTables, Xynolog.Tables

library internal
  import: settings, context-propagation, crypto
  build-depends: directory >=1.3 && <1.4, filepath >=1.5 && <1.6, time >=1.12 && <1.15
  visibility: private
  hs-source-dirs: src, internal, generated
  c-sources: internal/Xynolog/Internal/NativeStore.c
  include-dirs: generated/Xynolog/Internal/Generated
  cc-options: -Wall -Wextra -Werror
  if os(windows)
    extra-libraries: advapi32, bcrypt
  exposed-modules:
    Xynolog.Types
    Xynolog.Channels
    Xynolog.Running
    Xynolog.ErrorCodes
    Xynolog.Timing
    Xynolog.Timing.Settings
    Xynolog.Internal.Generated.TimingSettings
    Xynolog.Retry
    Xynolog.Discovery
    Xynolog.Discovery.Reasons
    Xynolog.Transport
    Xynolog.Transport.Facts
    Xynolog.StateValue
    Xynolog.Errors
    Xynolog.EventBus
    Xynolog.Bus
    Xynolog.Internal.Schema
    Xynolog.Internal.Required
    Xynolog.Internal.Cache
    Xynolog.Internal.CacheDocument
    Xynolog.Internal.Queries
    Xynolog.Internal.Delegation
    Xynolog.Internal.DelegatedVerbs
    Xynolog.Internal.Mark
    Xynolog.Internal.Yield
    Xynolog.Internal.Generated.OperationReports
    Xynolog.Internal.Browse
    Xynolog.Internal.Gather
    Xynolog.Internal.Match
    Xynolog.Internal.Refresh
    Xynolog.Internal.Text
    Xynolog.Internal.Utf8
    Xynolog.Internal.UnicodeCase
    Xynolog.Internal.StreamFrame
    Xynolog.Internal.Broadcast
    Xynolog.Internal.Sse
    Xynolog.Internal.Running
    Xynolog.Internal.Delivery
    Xynolog.Internal.StateValue
    Xynolog.Internal.Transport
    Xynolog.Registry
    Xynolog.Registry.Resources
    Xynolog.Registry.Factory
    Xynolog.Internal.Generated.SessionFactoryOptions
    Xynolog.Registry.Identity
    Xynolog.State.SessionSignals
    Xynolog.State.Beckon
    Xynolog.State.Match
    Xynolog.State.Gather
    Xynolog.State.Mark
    Xynolog.State.Yield
    Xynolog.Testing
    Xynolog.Testing.Client
    Xynolog.Testing.Transport
    Xynolog.Testing.Storage
    Xynolog.Testing.Sessions
    Xynolog.Testing.Liveness
    Xynolog.Internal.Generated.Testing
    Xynolog.Internal.Generated.PendingAnnotation
    Xynolog.Internal.Generated.MarkMotivation
    Xynolog.State.HoverDwell
    Xynolog.State.Search
    Xynolog.Internal.Generated.SearchState
    Xynolog.Internal.StateTasks
    Xynolog.StoragePersister
    Xynolog.Internal.Coupled
    Xynolog.Internal.Persistence
    Xynolog.Internal.Kept
    Xynolog.Internal.Generated.CachePersistence
    Xynolog.Internal.Generated.Stored
    Xynolog.Identity
    Xynolog.Internal.Generated.Principals
    Xynolog.Internal.Generated.BusLog
    Xynolog.Internal.Generated.TelemetryKeys
    Xynolog.Internal.Generated.TelemetryNames
    Xynolog.Internal.BusLog
    Xynolog.Internal.Generated.UnicodeCase
    Xynolog.Annotations
    Xynolog.Internal.Annotations.Id
    Xynolog.Internal.Annotations.Pdf
    Xynolog.Internal.Annotations.Spans
    Xynolog.Http
    Xynolog.Http.Discovery
    Xynolog.Content
    Xynolog.Gateway
    Xynolog.Frame
    Xynolog.Auth
    Xynolog.System
    Xynolog.Client
    Xynolog.JobFilter
    Xynolog.Claims
    Xynolog.HostName
    Xynolog.Worker
    Xynolog.Worker.Types
    Xynolog.Bind
    Xynolog.Beckon
    Xynolog.Job
    Xynolog.Cache
    Xynolog.Resources
    Xynolog.MediaTypes
    Xynolog.Browse
    Xynolog.Gather
    Xynolog.Match
    Xynolog.Delegation
    Xynolog.Mark
    Xynolog.Yield
    Xynolog.Tokens
    Xynolog.SessionStorage
    Xynolog.Session
    Xynolog.Issuer
    Xynolog.ClientAssertion
    Xynolog.ServiceToken
    Xynolog.SignIn
    Xynolog.SignInStore
    Xynolog.Registry.Stored
    Xynolog.Internal.Http
    Xynolog.Internal.HttpActor
    Xynolog.Internal.HttpContent
    Xynolog.Internal.Lifetime
    Xynolog.Http.Routes
    Xynolog.Archivist.Routes
    Xynolog.Control
    Xynolog.ServiceEnvironment
    Xynolog.ServiceTables
    Xynolog.Tables
    Xynolog.Internal.CarriedTable
    Xynolog.Internal.Generated.Text
    Xynolog.Internal.Generated.CacheRefresh
    Xynolog.Internal.Generated.Required
    Xynolog.Internal.Generated.Schemas
  other-modules:
    Paths_xynolog
    Xynolog.Internal.Telemetry
    Xynolog.Internal.Codec
    Xynolog.Internal.Bus
    Xynolog.Internal.Local
    Xynolog.Internal.RetryPolicy
    Xynolog.Internal.Generated.OperationFailure
    Xynolog.Internal.Generated.OAuth
    Xynolog.Internal.Generated.SignInStore
    Xynolog.Internal.NativeStore
    Xynolog.Internal.SignIn
    Xynolog.Internal.Stored
    Xynolog.Internal.Generated.ClientAssertion
    Xynolog.Internal.Generated.ServiceProof
    Xynolog.Internal.Issuer
    Xynolog.Internal.Digest
    Xynolog.Internal.Generated.WorkerChannels
@MODEL_MODULES@
  autogen-modules: Paths_xynolog

test-suite schema-cases
  import: settings, context-propagation, crypto
  build-tool-depends: hpc-codecov:hpc-codecov ==0.6.4.1
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  other-modules: Xynolog.Internal.Generated.RoundTrip, Xynolog.Internal.Generated.ChannelRoundTrip, Xynolog.Internal.Generated.ErrorRoundTrip, Xynolog.Internal.Generated.TimingValues, Xynolog.Internal.Generated.ServiceEnvironmentValues, Xynolog.Internal.Generated.DiscoveryReasonRoundTrip, Runtime, Discovery, BusCases, SchemaCases, HttpCases, HttpDiscoveryCases, AnnotationCases, IdentityCases, BusLogCases, PersistenceCases, PersistedCases, GatewayStage, CacheDocumentCases, StateUnitCases, FlowCases, ActorCases, TestingCases, RegistryCases, OpenResourceCases, RegistryErrorsCases, RegistryRuntimeCases, LifetimeCases, WorkerCases, GatewayCases, HeldCases, SurfaceCases, CacheCases, ControlledTime, ClockCases, ResourceCases, FrameCases, RefreshCases, TextCases, DelegationCases, TokenStorageCases, SessionCases, ShapeCases, IssuerCases, ClientAssertionCases, SignInStoreCases, TestProcess
  ghc-options: -threaded
  build-depends: xynolog:internal, process >=1.6 && <1.7, directory >=1.3 && <1.4, filepath >=1.5 && <1.6, time >=1.12 && <1.15

executable xynolog-haskell-wire-driver
  import: settings, context-propagation
  main-is: Main.hs
  other-modules: DriverProtocol
  hs-source-dirs: conformance
  ghc-options: -threaded
  build-depends: xynolog, http-client >=0.7 && <0.8, uuid >=1.3 && <1.4, uuid-types >=1.0 && <1.1, random >=1.3 && <1.4, hs-opentelemetry-sdk >=1.0 && <1.1

executable xynolog-haskell-live-driver
  import: settings, context-propagation
  main-is: LiveMain.hs
  other-modules: DriverProtocol, LiveQueries
  hs-source-dirs: conformance
  ghc-options: -threaded
  build-depends: xynolog, http-client >=0.7 && <0.8, uuid >=1.3 && <1.4, uuid-types >=1.0 && <1.1, random >=1.3 && <1.4, time >=1.12 && <1.15
