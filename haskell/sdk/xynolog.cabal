cabal-version: 3.0
name: xynolog
version: 0.8.2
synopsis: Typed Xynolog SDK for Haskell
description: Protocol-derived models for the Xynolog knowledge platform.
license: Apache-2.0
license-file: LICENSE
category: Network
homepage: https://github.com/xynolog/sdk
bug-reports: https://github.com/xynolog/sdk/issues
author: Xynolog
-- No address: the project is reached through its issue tracker.
maintainer: Xynolog, at https://github.com/xynolog/sdk/issues
build-type: Simple
-- The lowest is cabal.project's with-compiler, which the tests build with.
tested-with: GHC == 9.10.3 || == 9.12.4
extra-source-files: test/store-owner-policy.py, test/store-owner-policy.ps1, test/store-lock-peer.py, generated/Xynolog/Internal/Generated/xynolog_store_policy.h, test/fixtures/*.pem, xynolog.cabal.in, README.md, run.sh, api.py, public-api.inputs.json, public-api.json, test/refusals.py, test/refusals/*.hs, test/http-peer.py, conformance/README.md, conformance/launch.sh
extra-doc-files: CHANGELOG.md

source-repository head
  type: git
  location: https://github.com/xynolog/sdk.git
  subdir: haskell/sdk

common settings
  default-language: GHC2021
  ghc-options: -Wall -Wincomplete-patterns -Wincomplete-record-updates
  build-depends:
    base >=4.20 && <4.22,
    aeson >=2.3 && <2.4,
    async >=2.2 && <2.3,
    bytestring >=0.12 && <0.13,
    base64-bytestring >=1.2 && <1.3,
    containers >=0.7 && <0.8,
    regex-tdfa >=1.3 && <1.4,
    scientific >=0.3 && <0.4,
    stm >=2.5 && <2.6,
    streaming >=0.2 && <0.3,
    text >=2.1 && <2.2,
    vector >=0.13 && <0.14,
    QuickCheck >=2.19 && <2.20

common context-propagation
  build-depends: hs-opentelemetry-api >=1.0 && <1.1, http-client >=0.7 && <0.8, http-types >=0.12 && <0.13, case-insensitive >=1.2 && <1.3, network-uri >=2.6 && <2.7, uuid-types >=1.0 && <1.1, unordered-containers >=0.2 && <0.3

common crypto
  build-depends: crypton >=2.2 && <2.3, ram >=0.22 && <0.23, crypton-pem >=0.3 && <0.4, crypton-x509 >=1.10 && <1.11, crypton-x509-store >=1.10 && <1.11

library
  default-language: GHC2021
  build-depends: base >=4.20 && <4.22, xynolog:internal
  reexported-modules: Xynolog.Types, Xynolog.Channels, Xynolog.Running, Xynolog.ErrorCodes, Xynolog.Timing, Xynolog.Timing.Settings, Xynolog.Retry, Xynolog.Discovery, Xynolog.Discovery.Reasons, Xynolog.Transport, Xynolog.Transport.Facts, Xynolog.StateValue, Xynolog.Errors, Xynolog.EventBus, Xynolog.Bus, Xynolog.Http, Xynolog.Http.Discovery, Xynolog.Content, Xynolog.Gateway, Xynolog.Frame, Xynolog.Auth, Xynolog.System, Xynolog.Client, Xynolog.JobFilter, Xynolog.Claims, Xynolog.HostName, Xynolog.Worker, Xynolog.Worker.Types, Xynolog.Bind, Xynolog.Beckon, Xynolog.Job, Xynolog.Cache, Xynolog.Resources, Xynolog.MediaTypes, Xynolog.Browse, Xynolog.Gather, Xynolog.Match, Xynolog.Delegation, Xynolog.Mark, Xynolog.Yield, Xynolog.Tokens, Xynolog.SessionStorage, Xynolog.Session, Xynolog.Issuer, Xynolog.Registry.Stored, Xynolog.ClientAssertion, Xynolog.ServiceToken, Xynolog.SignIn, Xynolog.SignInStore, Xynolog.Annotations, Xynolog.Identity, Xynolog.StoragePersister, Xynolog.State.SessionSignals, Xynolog.Registry.Identity, Xynolog.Registry.Factory, Xynolog.Registry.Resources, Xynolog.Registry, Xynolog.State.HoverDwell, Xynolog.State.Search, Xynolog.State.Beckon, Xynolog.State.Match, Xynolog.State.Gather, Xynolog.State.Mark, Xynolog.State.Yield, Xynolog.Testing, Xynolog.Testing.Client, Xynolog.Testing.Transport, Xynolog.Testing.Storage, Xynolog.Testing.Sessions, Xynolog.Testing.Liveness, Xynolog.Archivist.Routes, Xynolog.Control, Xynolog.ServiceEnvironment, Xynolog.ServiceTables, Xynolog.Tables

library internal
  import: settings, context-propagation, crypto
  build-depends: directory >=1.3 && <1.4, filepath >=1.5 && <1.6, time >=1.12 && <1.15
  visibility: private
  hs-source-dirs: src, internal, generated
  c-sources: internal/Xynolog/Internal/NativeStore.c
  include-dirs: generated/Xynolog/Internal/Generated
  cc-options: -Wall -Wextra -Werror
