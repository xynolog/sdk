(lang dune 3.24)
(repository
 (name pinned)
 (url "git+https://github.com/ocaml/opam-repository.git#1e8ccc4347bd42cdf513d376cdad11075f385a8c"))
(lock_dir
 (repositories pinned-overlay pinned)
 ; The lock builds and tests the package on the toolchain's compiler; the
 ; opam file admits each compiler dune-project names.
 (constraints (ocaml (= 5.5.2)) (ocamlfind (< 1.9.9~preview))))

(repository
 (name pinned-overlay)
 (url "git+https://github.com/ocaml-dune/opam-overlays.git#99fc2e18c45b4761ed5f6d282910c03c97e32bce"))

; ocamlformat is a development tool, which `dune tools install ocamlformat`
; locks and builds apart from the package, at .ocamlformat's version, from the
; same pinned repositories.
(lock_dir
 (path "_build/.dev-tools.locks/ocamlformat")
 (repositories pinned-overlay pinned)
 (constraints (ocaml (= 5.5.2))))
