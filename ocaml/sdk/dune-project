(lang dune 3.24)
(name xynolog)
(formatting (enabled_for ocaml))
(generate_opam_files true)
(source (github xynolog/sdk))
(license Apache-2.0)
(authors "Xynolog")
(maintainers "Xynolog maintainers")
(package
 (name xynolog)
 (synopsis "Typed Eio client for Xynolog knowledge bases")
 (description "Xynolog's OCaml SDK, held to its shared protocol and client contracts.")
 (depends
  (ocaml (>= 5.5))
  (eio (>= 1.6))
  eio_main
  (cohttp-eio (>= 6.3.0))
  tls-eio
  x509
  mirage-crypto-pk
  mirage-crypto-rng
  (yojson (>= 3.0.0))
  base64
  zarith
  decimal
  digestif
  uri
  uutf
  uucp
  re
  mtime
  ptime
  cstruct
  ipaddr
  domain-name
  (opentelemetry (>= 0.92))
  (ambient-context-eio :with-test)
  (alcotest :with-test)
  (qcheck :with-test)
  (bisect_ppx_ng :with-test)
  (ocamlformat (and :with-dev-setup (= 0.29.0)))
  (odoc :with-doc)))
