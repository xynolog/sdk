(test
 (name transport)
 (modules transport)
 (libraries xynolog eio_main eio.mock cohttp-eio tls-eio mirage-crypto-rng.unix
  x509 uri mtime ptime cstruct domain-name alcotest)
 (deps peer-cert.pem peer-key.pem))

; The certificate expires two days after the rule runs, so no cache may keep it.
(rule
 (targets peer-cert.pem peer-key.pem)
 (deps (universe))
 (action (run %{exe:peer_cert.exe})))

(executable
 (name peer_cert)
 (modules peer_cert)
 (libraries x509 mirage-crypto-rng.unix ptime ptime.clock.os))

(library
 (name native_lock)
 (wrapped false)
 (modules native_lock)
 (libraries unix)
 (foreign_stubs (language c) (names native_lock_stubs)))

(test
 (name storage)
 (modules storage store_policy)
 (libraries native_lock unix eio_main eio.mock alcotest))

(test
 (name runtime)
 (modules runtime)
 (libraries xynolog eio_main eio.mock mtime alcotest))

(executable
 (name api_inventory)
 (modules api_inventory)
 (libraries compiler-libs.common yojson))

(test
 (name capabilities)
 (modules capabilities)
 (libraries protocol_cases eio_main ambient-context-eio opentelemetry x509 uutf cstruct
  mirage-crypto-rng.unix alcotest)
 (deps peer-key.pem))

(test
 (name json_boundary)
 (modules json_boundary)
 (libraries xynolog yojson uutf qcheck alcotest))

(test
