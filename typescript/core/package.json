{
  "name": "@xynolog/core",
  "version": "0.8.1",
  "description": "Core types and domain logic for Xynolog - Resource, Annotation, and Graph models",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "default": "./dist/testing.js"
    },
    "./testing/axioms": {
      "types": "./dist/testing/axioms.d.ts",
      "import": "./dist/testing/axioms.js",
      "default": "./dist/testing/axioms.js"
    },
    "./testing/issuer": {
      "types": "./dist/testing/issuer.d.ts",
      "import": "./dist/testing/issuer.js",
      "default": "./dist/testing/issuer.js"
    },
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "import": "./dist/openapi.js",
      "default": "./dist/openapi.js"
    }
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xynolog/sdk.git",
    "directory": "typescript/core"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && tsup && tsc -p tsconfig.build.json && rollup -c rollup.dts.config.mjs && rm -rf dist-types",
    "watch": "tsup --watch",
    "clean": "rm -rf dist *.tsbuildinfo",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "types",
    "domain",
    "resource",
    "annotation",
    "graph",
    "xynolog"
  ],
  "author": "Xynolog Team",
  "sideEffects": false,
  "license": "Apache-2.0",
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.5",
    "ajv": "^8.20.0",
    "fast-check": "^4.10.0",
    "rollup": "^4.67.5",
    "rollup-plugin-dts": "^6.4.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "jose": "^6.2.15",
    "rxjs": "^7.8.1"
  },
  "peerDependencies": {
    "fast-check": "^4.8.0"
  },
  "peerDependenciesMeta": {
    "fast-check": {
      "optional": true
    }
  }
}
