<Project>
  <PropertyGroup>
    <!-- The framework every project builds for. The SDK's library also builds for .NET 10 (src/Xynolog/Xynolog.csproj). -->
    <XynologTargetFramework>net11.0</XynologTargetFramework>
    <TargetFramework>$(XynologTargetFramework)</TargetFramework>
    <!-- Locked restore covers both self-contained driver deployment graphs. -->
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <XynologBuildToolGlobalPropertiesToRemove>RuntimeIdentifier;SelfContained;PublishSingleFile;PublishTrimmed;PublishReadyToRun;PublishAot</XynologBuildToolGlobalPropertiesToRemove>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'Xynolog.Analyzers'">
    <!-- Analyzers execute on the build host, not the application deployment target. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)analyzers/Xynolog.Analyzers/Xynolog.Analyzers.csproj" GlobalPropertiesToRemove="$(XynologBuildToolGlobalPropertiesToRemove)" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <!-- SEM007 holds product code to the caller's clock; a test project keeps its own time. -->
    <CompilerVisibleProperty Include="IsTestProject" />
  </ItemGroup>
</Project>
