<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>The Xynolog SDK for .NET.</Description>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- What nuget.org shows as the release notes: the changelog as of the release, which sdk_version.py write keeps at the coming release's tag. -->
    <PackageReleaseNotes>https://github.com/xynolog/sdk/blob/v0.8.1/csharp/sdk/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <ProjectReference Include="../../tools/RefusalRunner/RefusalRunner.csproj" GlobalPropertiesToRemove="$(XynologBuildToolGlobalPropertiesToRemove)" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
