<?xml version="1.0" encoding="utf-8"?>
<!-- The bundle's package, and every dependency from nuget.org. -->
<configuration>
  <packageSources>
    <clear />
    <add key="bundle" value="/bundle" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
