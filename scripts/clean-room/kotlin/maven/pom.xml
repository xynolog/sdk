<?xml version="1.0" encoding="UTF-8"?>
<!-- A Java application of the publication alone, as Maven reads its POM: the
     bundle's repository for it, Maven Central for what the POM names. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.xynolog.cleanroom</groupId>
  <artifactId>consumer</artifactId>
  <version>1</version>
  <properties>
    <maven.compiler.release>${java.release}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>
  <repositories>
    <repository>
      <id>bundle</id>
      <url>file:///tmp/repo</url>
    </repository>
  </repositories>
  <dependencies>
    <dependency>
      <groupId>org.xynolog</groupId>
      <artifactId>xynolog</artifactId>
      <version>${xynolog.version}</version>
    </dependency>
  </dependencies>
</project>
